{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "4.0.4",
  "description": "__MSG_extensionDescription__",
  "permissions": [
    "storage",
    "unlimitedStorage"
  ],
  "action": {
    "default_title": "__MSG_extensionName__",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "phonology.js",
        "dictionary-render.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "background": {
    "service_worker": "background-bootstrap.js"
  },
  "default_locale": "en",
  "version_name": "1.0.0"
}
